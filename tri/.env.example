# ---------- Tri Configuration ----------
PORT=3710

# Authentication
# A long random password. Your voice agent sends it with every tool call.
TRI_TOKEN=
# Also accepted for backward compatibility: JARVIS_TOKEN=

# YOUR mobile number, digits only, with country code. Example: 919876543210
# Calls from any other number are refused.
OWNER_NUMBER=
TRI_OWNER=

# true while you test, set to false once phone calls work
ALLOW_NO_CALLER=true
TRI_ALLOW_NO_CALLER=true

# Your phone number (for display)
TRI_PHONE=

# ---------- Optional: Tri calls YOU (deadline + battery reminders) ----------
SARVAM_WORKSPACE_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
TRI_APP_ID=
TRI_APP_VERSION=1
TRI_AGENT_NUMBER=
TRI_CONNECTION_ID=

# ---------- Optional: Google Classroom uploads ----------
# Empty = off. attach = upload the file but do NOT turn it in. live = upload AND turn in.
CLASSROOM_SUBMIT=
